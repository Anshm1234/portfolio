# ---- required: the FAQ bot's only secret ----
# Server-side only. Read by api/ask.js, never bundled into the client.
#   local dev  -> copy this file to .env.local and fill it in
#   production -> Vercel dashboard > Settings > Environment Variables
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- retrieval mode ----
# `vector` runs the real RAG path: the question is embedded and cosine-ranked
# against the stored chunk vectors. Requires `npm run ingest -- --embed` to
# have generated api/_lib/embeddings.generated.js.
#
# Anything else (or unset) sends the whole corpus instead. That still answers
# correctly, but it is not retrieval.
#
# SET THIS ON VERCEL TOO — without it production silently runs the non-RAG
# path while local runs RAG, which is a painful divergence to notice later.
RETRIEVER=vector
